{
  "name": "com.college.smartcampus",
  "displayName": "HU Smart Campus",
  "version": "1.0.0",
  "description": "GPS based campus navigation app for Himalayan University using OpenStreetMap (Leaflet) and Firebase",
  "main": "index.js",
  "scripts": {
    "serve": "npx http-server www -p 8080 -c-1",
    "test": "jest",
    "android": "cordova run android",
    "build:android": "cordova build android --release"
  },
  "keywords": [
    "ecosystem:cordova",
    "campus",
    "navigation",
    "leaflet",
    "firebase"
  ],
  "license": "MIT",
  "devDependencies": {
    "cordova": "^10.0.0",
    "cordova-android": "^9.0.0",
    "cordova-plugin-geolocation": "^4.1.0",
    "cordova-plugin-network-information": "^2.0.2",
    "jest": "^25.5.4"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-geolocation": {
        "GPS_REQUIRED": "true"
      },
      "cordova-plugin-network-information": {}
    }
  }
}
